@model PRN222_SWP_TOOL_MVC.Service.DTO.QnA.CreateQuestionRequest

@{
    ViewData["Title"] = "Đặt câu hỏi mới";
    Layout = "~/Views/Shared/StudentLayout/_StudentLayout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Student" asp-action="Index">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="StudentQna" asp-action="Index"
                           asp-route-groupId="@Model.GroupId">Câu hỏi</a>
                    </li>
                    <li class="breadcrumb-item active">Tạo mới</li>
                </ol>
            </nav>

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-send me-2"></i>Đặt câu hỏi cho giảng viên</h5>
                </div>
                <div class="card-body">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-1"></i>
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <!-- GroupId & TopicId ẩn -->
                        <input type="hidden" name="GroupId" value="@Model.GroupId" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Topic <span class="text-danger">*</span>
                            </label>
                            <select name="TopicId" class="form-select" required>
                                <option value="">-- Chọn topic --</option>
                                @if (ViewBag.Topics != null)
                                {
                                    foreach (var t in (IEnumerable<PRN222_SWP_TOOL_MVC.Repository.Entities.Topic>)ViewBag.Topics)
                                    {
                                        <option value="@t.TopicID">@t.TopicName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tiêu đề <small class="text-muted">(tuỳ chọn)</small></label>
                            <input type="text" name="Title" value="@Model.Title"
                                   class="form-control" placeholder="Nhập tiêu đề câu hỏi..." maxlength="200" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                Nội dung câu hỏi <span class="text-danger">*</span>
                            </label>
                            <textarea name="Content" class="form-control" rows="6"
                                      placeholder="Mô tả chi tiết vấn đề bạn cần hỏi..."
                                      required maxlength="2000">@Model.Content</textarea>
                            <div class="form-text text-end">
                                <span id="contentCount">0</span>/2000 ký tự
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send me-1"></i> Gửi câu hỏi
                            </button>
                            <a href="javascript:history.back()" class="btn btn-secondary">
                                <i class="bi bi-x-circle me-1"></i> Huỷ
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const textarea = document.querySelector('textarea[name="Content"]');
        const counter  = document.getElementById('contentCount');
        if (textarea && counter) {
            counter.textContent = textarea.value.length;
            textarea.addEventListener('input', () => {
                counter.textContent = textarea.value.length;
            });
        }
    </script>
}
