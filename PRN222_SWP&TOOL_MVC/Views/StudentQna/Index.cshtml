@model List<PRN222_SWP_TOOL_MVC.Repository.Entities.Question>

@{
    ViewData["Title"] = "Câu hỏi của tôi";
    Layout = "~/Views/Shared/StudentLayout/_StudentLayout.cshtml";

    string StatusBadgeClass(string status) => status switch
    {
        "ANSWERED"   => "bg-success",
        "PROCESSING" => "bg-warning text-dark",
        "CLOSED"     => "bg-secondary",
        _            => "bg-danger"
    };

    string StatusLabel(string status) => status switch
    {
        "ANSWERED"   => "Đã trả lời",
        "PROCESSING" => "Đang xử lý",
        "CLOSED"     => "Đã đóng",
        _            => "Chờ xử lý"
    };
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-chat-square-text me-2"></i>Hỏi & Đáp</h4>
            <small class="text-muted">Danh sách câu hỏi của nhóm bạn</small>
        </div>
        @if (Model != null && Model.Any())
        {
            <a asp-action="Create" asp-route-groupId="@Model.First().GroupID"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Đặt câu hỏi mới
            </a>
        }
    </div>

    <!-- TempData thông báo -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-1"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Danh sách câu hỏi -->
    @if (Model == null || !Model.Any())
    {
        <div class="card p-5 text-center text-muted">
            <i class="bi bi-inbox fs-1 mb-3 d-block"></i>
            <h5>Chưa có câu hỏi nào</h5>
            <p class="mb-0">Bạn cần tham gia nhóm và chọn đề tài trước khi đặt câu hỏi.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var q in Model.OrderByDescending(q => q.CreatedAt))
            {
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="fw-bold mb-1 me-3">
                                    @(string.IsNullOrWhiteSpace(q.Title) ? "Không có tiêu đề" : q.Title)
                                </h6>
                                <span class="badge @StatusBadgeClass(q.Status) flex-shrink-0">
                                    @StatusLabel(q.Status)
                                </span>
                            </div>
                            <p class="text-muted small mb-2">@q.Content</p>
                            <div class="d-flex gap-3 text-muted small">
                                <span><i class="bi bi-clock me-1"></i>@q.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                <span><i class="bi bi-chat-dots me-1"></i>@q.Messages.Count tin nhắn</span>
                            </div>
                        </div>
                        <div class="card-footer bg-light">
                            <a asp-action="Detail" asp-route-id="@q.Id"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i> Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-4">
        <a href="javascript:history.back()" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>
