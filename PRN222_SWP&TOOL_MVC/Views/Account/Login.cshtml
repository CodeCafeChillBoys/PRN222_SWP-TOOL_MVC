<style>
    body {
        background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('/Image/FPT.png');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-logo span {
        color: #ffffff;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }

    .card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
</style>

@{
    ViewData["Title"] = "Login";
    Layout = "AuthenLayout/_AuthLayout";
}

<div class="login-box">

    <div class="login-logo d-flex align-items-center justify-content-center mb-3">
        <div class="bg-primary rounded d-flex align-items-center justify-content-center me-2"
             style="width: 40px; height: 40px; font-size: 20px;">
            🎓
        </div>
        <span class="fw-bold fs-4 text-uppercase">SWP&TOOL</span>
    </div>

    <div class="card">
        <div class="card-body login-card-body p-4">
            <p class="login-box-msg text-center mb-3">Đăng Nhập</p>

            <!-- Login thường -->
            <form action="#" method="post">
                <div class="input-group mb-3">
                    <input type="email" class="form-control" placeholder="Email">
                    <div class="input-group-text">
                        <span class="fas fa-envelope"></span>
                    </div>
                </div>

                <div class="input-group mb-3">
                    <input type="password" class="form-control" placeholder="Mật Khẩu">
                    <div class="input-group-text">
                        <span class="fas fa-lock"></span>
                    </div>
                </div>

                <div class="row align-items-center mb-3">
                    <div class="col-8">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="remember">
                            <label class="form-check-label" for="remember">
                                Nhớ Mật Khẩu
                            </label>
                        </div>
                    </div>
                    <div class="col-4">
                        <button type="submit" class="btn btn-primary w-100">
                            Login
                        </button>
                    </div>
                </div>
            </form>

            <!-- Google Login -->
            <div class="social-auth-links text-center d-grid gap-2">
                <form asp-controller="Account"
                      asp-action="GoogleLogin"
                      method="get">
                    <button type="submit" class="btn btn-google w-100">
                        <i class="fab fa-google-plus me-2"></i>
                        Đăng Nhập Bằng Google
                    </button>
                </form>

                <p class="mb-1">
                    <a href="#" class="text-decoration-none">Quên Mật Khẩu</a>
                </p>
                <p class="mb-0">
                    <a href="#" class="text-decoration-none">Đăng Kí</a>
                </p>
            </div>

        </div>
    </div>
</div>