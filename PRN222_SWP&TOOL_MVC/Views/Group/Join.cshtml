@{
    ViewData["Title"] = "Tham gia nhóm";
    Layout = "~/Views/Shared/StudentLayout/_StudentLayout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="bi bi-people me-2"></i>Tham gia nhóm bằng mã mời</h4>
                </div>
                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger py-2">
                            <i class="bi bi-exclamation-triangle me-1"></i> @ViewBag.Error
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success py-2">
                            <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
                        </div>
                    }

                    <p class="text-muted small mb-3">
                        Nhập mã mời (8 ký tự) do nhóm trưởng cung cấp.
                    </p>

                    <form method="post" asp-action="Join" asp-controller="Group">
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Mã mời <span class="text-danger">*</span></label>
                            <input type="text"
                                   name="inviteCode"
                                   class="form-control form-control-lg text-center text-uppercase fw-bold letter-spacing-2"
                                   placeholder="ABC12345"
                                   maxlength="8"
                                   style="letter-spacing: 4px; font-size: 1.5rem;"
                                   required
                                   autocomplete="off" />
                            <div class="form-text">Mã gồm 8 ký tự chữ và số, không phân biệt hoa/thường.</div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success flex-grow-1">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Tham gia
                            </button>
                            <a href="javascript:history.back()" class="btn btn-secondary flex-grow-1">
                                <i class="bi bi-arrow-left me-1"></i> Huỷ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
