@model PRN222_SWP_TOOL_MVC.Models.GroupViewModels.GroupDetailsViewModel

@{
    ViewData["Title"] = "Group Details";
    Layout = "~/Views/Shared/StudentLayout/_StudentLayout.cshtml";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    @ViewBag.Message
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model.GroupID == 0)
            {
                <div class="card mb-4">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-inbox" style="font-size: 3rem; color: #6c757d;"></i>
                        <h4 class="mt-3 text-muted">@Model.GroupName</h4>
                        <p class="text-muted">Bạn hiện chưa tham gia nhóm nào.</p>

                        <a class="btn btn-primary" asp-controller="Group" asp-action="Create" asp-route-classId="@Model.ClassID">
                            <i class="bi bi-plus-circle"></i> Create Group
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="mb-0">
                                    <i class="bi bi-people"></i> @Model.GroupName
                                </h4>
                            </div>
                            <div class="col-auto">
                                <span class="badge bg-info">@Model.MemberCount / @Model.MaxMember Members</span>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h6 class="text-muted">Status</h6>
                                <p>
                                    @if (Model.IsLocked)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-lock"></i> Locked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-unlock"></i> Open
                                        </span>
                                    }
                                </p>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted">Invite Code</h6>
                                <p>
                                    <code class="bg-light p-2 d-inline-block">@(string.IsNullOrWhiteSpace(Model.InviteCode) ? "N/A" : Model.InviteCode)</code>
                                </p>
                            </div>
                        </div>

                        <h5 class="mb-3">
                            <i class="bi bi-person-check"></i> Members
                        </h5>

                        @if (Model.Members != null && Model.Members.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Student ID</th>
                                            <th>Full Name</th>
                                            <th>Role</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var member in Model.Members)
                                        {
                                            <tr>
                                                <td>
                                                    <code>@member.StudentID</code>
                                                </td>
                                                <td>@(string.IsNullOrWhiteSpace(member.FullName) ? "(No name)" : member.FullName)</td>
                                                <td>
                                                    @if (member.IsLeader)
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            <i class="bi bi-star-fill"></i> Leader
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Member</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> No members yet.
                            </div>
                        }
                    </div>

                    <div class="card-footer bg-light d-flex gap-2">
                        <a href="javascript:history.back()" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
