@model PRN222_SWP_TOOL_MVC.Models.GroupViewModels.CreateGroupViewModel

@{
    ViewData["Title"] = "Create New Group";
    Layout = "~/Views/Shared/StudentLayout/_StudentLayout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Create New Group</h3>
                </div>

                <div class="card-body">
                    <form method="post" asp-action="Create" asp-controller="Group">
                        
                        <input type="hidden" asp-for="ClassID" />

                        <div class="mb-3">
                            <label for="groupName" class="form-label">Group Name</label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="groupName"
                                asp-for="GroupName" 
                                placeholder="Enter group name"
                                required />
                            <span asp-validation-for="GroupName" class="text-danger"></span>
                        </div>

                        <div class="alert alert-info" role="alert">
                            <strong>Note:</strong> You will be automatically assigned as the group leader.
                        </div>

                        @if (ViewBag.Message != null)
                        {
                            <div class="alert alert-danger" role="alert">
                                @ViewBag.Message
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i class="bi bi-check-circle"></i> Create Group
                            </button>
                            <a href="javascript:history.back()" class="btn btn-secondary flex-grow-1">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
