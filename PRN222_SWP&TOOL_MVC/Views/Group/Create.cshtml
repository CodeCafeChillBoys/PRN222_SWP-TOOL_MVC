@model PRN222_SWP_TOOL_MVC.Models.GroupViewModels.CreateGroupViewModel

@{
    ViewData["Title"] = "Tạo nhóm mới";
    Layout = "~/Views/Shared/StudentLayout/_StudentLayout.cshtml";
    var classes = ViewBag.Classes as List<PRN222_SWP_TOOL_MVC.Repository.Entities.Class>
                  ?? new List<PRN222_SWP_TOOL_MVC.Repository.Entities.Class>();
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-people me-2"></i>Tạo nhóm mới</h4>
                </div>

                <div class="card-body">
                    <form method="post" asp-action="Create" asp-controller="Group">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ClassID" id="hiddenClassID" />

                        @* Nếu ClassID đã được truyền từ link (> 0), ẩn dropdown *@
                        @if (Model.ClassID > 0)
                        {
                            <div class="alert alert-info py-2">
                                <i class="bi bi-info-circle me-1"></i>
                                Tạo nhóm trong lớp: <strong>
                                    @(classes.FirstOrDefault(c => c.ClassID == Model.ClassID)?.ClassName ?? $"ID {Model.ClassID}")
                                </strong>
                            </div>
                        }
                        else
                        {
                            <!-- Dropdown chọn lớp khi ClassID chưa được truyền -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Lớp học <span class="text-danger">*</span>
                                </label>
                                @if (!classes.Any())
                                {
                                    <div class="alert alert-warning py-2">
                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                        Hiện chưa có lớp học nào trong hệ thống.
                                    </div>
                                }
                                else
                                {
                                    <select class="form-select" id="classSelect" required
                                            onchange="document.getElementById('hiddenClassID').value = this.value">
                                        <option value="0">-- Chọn lớp học --</option>
                                        @foreach (var c in classes)
                                        {
                                            <option value="@c.ClassID">@c.ClassName (@c.ClassCode)</option>
                                        }
                                    </select>
                                    <span asp-validation-for="ClassID" class="text-danger small"></span>
                                }
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Tên nhóm <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control"
                                   asp-for="GroupName"
                                   placeholder="Nhập tên nhóm..."
                                   required maxlength="100" />
                            <span asp-validation-for="GroupName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Số thành viên tối đa</label>
                            <input type="number"
                                   class="form-control"
                                   asp-for="MaxMember"
                                   min="2" max="10" value="5" />
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2">
                                @Html.ValidationSummary(false)
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i class="bi bi-check-circle me-1"></i> Tạo nhóm
                            </button>
                            <a href="javascript:history.back()" class="btn btn-secondary flex-grow-1">
                                <i class="bi bi-arrow-left me-1"></i> Huỷ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Sync select value sang hidden input lúc load
        const sel = document.getElementById('classSelect');
        const hid = document.getElementById('hiddenClassID');
        if (sel && hid) {
            sel.addEventListener('change', () => hid.value = sel.value);
        }
    </script>
}
