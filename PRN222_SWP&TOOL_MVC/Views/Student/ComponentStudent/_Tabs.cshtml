               asp-action="Index"
               asp-route-tab="topic">
                <i class="fa-solid fa-book-open me-2"></i>
                Chọn Đề tài
            </a>
        </li>

        <li class="nav-item flex-fill text-center">
            <a class="nav-link tab-qa @(Model.CurrentTab == "qa" ? "active" : "")"
               asp-controller="Student"
               asp-action="Index"
               asp-route-tab="qa">
                <i class="fa-regular fa-comment me-2"></i>
                Hỏi & Đáp
            </a>
        </li>

    </ul>
