<div class="student-tabs mt-4">
    <ul class="nav nav-pills custom-tabs mb-4">
        <li class="nav-item flex-fill text-center">
            <a class="nav-link tab-group @(Model.CurrentTab == "group" ? "active" : "")"
               asp-controller="Student"
               asp-action="Index"
               asp-route-tab="group">
                <i class="fa-solid fa-users me-2"></i>
                Quản lý Nhóm
            </a>
        </li>

        <li class="nav-item flex-fill text-center">
            <a class="nav-link tab-topic @(Model.CurrentTab == "topic" ? "active" : "")"
