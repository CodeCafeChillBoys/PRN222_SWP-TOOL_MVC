@model PRN222_SWP_TOOL_MVC.Service.DTO.Request.StudentDashboardRequestDTO

@{
    var selectedTopic = Model.Topics
        ?.FirstOrDefault(t => t.TopicID == Model.SelectedTopicId);
}

@if (selectedTopic != null)
{
    <div class="topic-registered-banner">
        <i class="fa-solid fa-circle-check"></i>
        <div>
            <span>Nhóm của bạn đã đăng ký đề tài:</span>
            <strong>@selectedTopic.TopicName</strong>
        </div>
    </div>
}

<div id="miniModal" class="mini-overlay hidden">
    <div class="mini-modal">
        <div class="mini-header">
            <h5 id="miniTitle">Thông báo</h5>
            <span class="mini-close" onclick="closeMiniModal()">×</span>
        </div>

        <p id="miniMessage" class="mini-message"></p>

        <div class="mini-actions">
            <button class="btn-cancel" onclick="closeMiniModal()">Hủy</button>
        </div>
    </div>
</div>

@foreach (var topic in Model.Topics)
{
    var isSelected = Model.SelectedTopicId.HasValue
                     && Model.SelectedTopicId.Value == topic.TopicID;
    var hasSelected = Model.SelectedTopicId.HasValue;
    var currentCount = topic.TopicRegistrations?.Count ?? 0;
    var maxGroup = topic.MaxGroupCount ?? 5;
    var isFull = currentCount >= maxGroup;
    <div class=" col-12 mb-4">
        <div class="topic-card @(isSelected ? "selected" : "")">
            <div class="topic-header">
                <div class="topic-title">
                    <div class="topic-icon @(isSelected ? "selected" : "")">
                        <i class="fa-solid fa-book-open"></i>
                    </div>

                    <div>
                        <h5>@topic.TopicName</h5>
                        <p class="lecturer">
                            <i class="fa-solid fa-user-tie me-1"></i>
                            @topic.Teacher?.User?.FullName
                        </p>
                    </div>
                </div>

                <div class="topic-badges">
                    @* Badge Đã chọn *@
                    @if (isSelected)
                    {
                        <span class="badge selected-badge">
                            <i class="fa-solid fa-check me-1"></i> Đã chọn
                        </span>
                    }

                    <span class="badge group-count">
                        <i class="fa-solid fa-users me-1"></i>
                        @currentCount/@maxGroup nhóm
                    </span>
                </div>
            </div>

            <div class="topic-description">
                @topic.Description
            </div>

            <div class="topic-requirement">
                <strong>Yêu cầu:</strong>
                <p>@topic.Requirement</p>
            </div>

            @* ===== BUTTON LOGIC ===== *@

            @if (hasSelected)
            {
                if (isSelected)
                {
                    <!-- Ẩn luôn nút nếu đã chọn -->
                }
                else
                {
                    <button class="btn-select disabled-btn" disabled>
                        Không thể chọn
                    </button>
                }
            }
            else
            {
                if (isFull)
                {
                    <button class="btn-select disabled-btn" disabled>
                        Đã đủ nhóm
                    </button>
                }
                else
                {
                    <button class="btn-select select-topic" data-id="@topic.TopicID">
                        <i class="fa-solid fa-paper-plane me-1"></i>
                        Chọn đề tài
                    </button>
                }
            }
        </div>
    </div>
}