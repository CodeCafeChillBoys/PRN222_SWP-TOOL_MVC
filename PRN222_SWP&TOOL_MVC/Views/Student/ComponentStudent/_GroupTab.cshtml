﻿<!-- TAB: QUẢN LÝ NHÓM -->
<div id="tab-group" class="tab-content">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card p-4 h-100">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-people"></i>
                    <strong>Tạo nhóm mới</strong>
                </div>
                <p class="text-muted">
                    Tạo nhóm và mời các thành viên khác tham gia
                </p>
                <button class="btn btn-gradient w-100">
                    Tạo nhóm
                </button>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-4 h-100">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-person-plus"></i>
                    <strong>Tham gia nhóm</strong>
                </div>
                <p class="text-muted">
                    Nhập mã mời để tham gia nhóm hiện có
                </p>

                <label class="form-label">Mã mời</label>
                <input type="text"
                       class="form-control mb-3"
                       placeholder="Nhập mã mời (VD: ABC123)">

                <button class="btn btn-secondary w-100">
                    Tham gia
                </button>
            </div>
        </div>
    </div>
</div>