@model PRN222_SWP_TOOL_MVC.Service.Models.GroupDetailsViewModel

<h2>Group Details</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-warning">@ViewBag.Message</div>
}

@if (Model.GroupID == 0)
{
    <div class="card p-3 mb-3">
        <h4>@Model.GroupName</h4>
        <p>Bạn hiện chưa tham gia nhóm nào.</p>

        <a class="btn btn-primary" asp-controller="Group" asp-action="Create" asp-route-classId="@Model.ClassID">
            Create Group
        </a>
    </div>
    return;
}
<h4>Members</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>StudentID</th>
            <th>FullName</th>
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model.Members)
        {
            <tr>
                <td>@m.StudentID</td>
                <td>@(string.IsNullOrWhiteSpace(m.FullName) ? "(no name)" : m.FullName)</td>
                <td>@(m.IsLeader ? "Leader" : "Member")</td>
            </tr>
        }
    </tbody>
</table>