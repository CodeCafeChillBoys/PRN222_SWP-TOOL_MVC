@model PRN222_SWP_TOOL_MVC.Service.Models.GroupDetailsViewModel

@if (ViewBag.Message != null)
{
    <div class="alert alert-warning">@ViewBag.Message</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div>
}

@if (Model.GroupID == 0)
{
    <div class="card p-4 mb-3">
        <h5><i class="bi bi-people me-2"></i>Bạn chưa tham gia nhóm nào.</h5>
        <p class="text-muted small mb-3">Tạo nhóm mới hoặc tham gia nhóm hiện có bằng mã mời.</p>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-controller="Group" asp-action="Create" asp-route-classId="@Model.ClassID">
                <i class="bi bi-plus-circle me-1"></i> Tạo nhóm
            </a>
            <a class="btn btn-outline-success" asp-controller="Group" asp-action="Join">
                <i class="bi bi-box-arrow-in-right me-1"></i> Tham gia bằng mã
            </a>
        </div>
    </div>
    return;
}

<!-- Thông tin nhóm + Invite Code -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-md-6">
                <h5 class="fw-bold mb-1">
                    <i class="bi bi-people-fill text-primary me-2"></i>@Model.GroupName
                </h5>
                <div class="d-flex gap-3 text-muted small">
                    <span><i class="bi bi-person-fill me-1"></i>@Model.MemberCount / @Model.MaxMember thành viên</span>
                    @if (Model.IsLocked)
                    {
                        <span class="text-danger"><i class="bi bi-lock-fill me-1"></i>Nhóm đã đầy (khoá)</span>
                    }
                    else
                    {
                        <span class="text-success"><i class="bi bi-unlock-fill me-1"></i>Còn nhận thành viên</span>
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.InviteCode))
            {
                <div class="col-md-6 text-md-end">
                    <div class="d-inline-block bg-light border rounded-3 px-4 py-2">
                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-key me-1"></i>Mã mời — chia sẻ cho thành viên
                        </small>
                        <span id="inviteCodeText"
                              class="fw-bold fs-3 font-monospace text-primary"
                              style="letter-spacing:6px">@Model.InviteCode</span>
                        <button class="btn btn-sm btn-outline-secondary ms-2"
                                id="copyBtn"
                                onclick="navigator.clipboard.writeText('@Model.InviteCode').then(()=>{const b=document.getElementById('copyBtn');b.innerHTML='<i class=\'bi bi-check2\'></i>';setTimeout(()=>b.innerHTML='<i class=\'bi bi-clipboard\'></i>',2000)})"
                                title="Copy mã mời">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Danh sách thành viên -->
<h5 class="fw-semibold mb-3"><i class="bi bi-person-lines-fill me-2"></i>Danh sách thành viên</h5>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Họ tên</th>
                    <th class="text-center">Vai trò</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var m in Model.Members)
                {
                    <tr>
                        <td class="text-muted small">@(idx++)</td>
                        <td>
                            <i class="bi bi-person-circle me-2 text-secondary"></i>
                            @(string.IsNullOrWhiteSpace(m.FullName) ? $"Student #{m.StudentID}" : m.FullName)
                        </td>
                        <td class="text-center">
                            @if (m.IsLeader)
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-star-fill me-1"></i>Nhóm trưởng
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">Thành viên</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>