@{
    ViewData["Title"] = "Student";
    Layout = "~/Views/Shared/StudentLayout/_StudentLayout.cshtml";
}
<div class="container-fluid min-vh-100">
    <div class="container">
        <div class="row g-3 mb-4">
            @await Html.PartialAsync("~/Views/Student/ComponentStudent/_StatusCard.cshtml")
        </div>
        @await Html.PartialAsync("~/Views/Student/ComponentStudent/_Tabs.cshtml")
        <div class="tab-content">
            @await Html.PartialAsync("~/Views/Student/ComponentStudent/_GroupTab.cshtml")
            @await Html.PartialAsync("~/Views/Student/ComponentStudent/_TopicTab.cshtml")
            @await Html.PartialAsync("~/Views/Student/ComponentStudent/_QATab.cshtml")
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const btn = document.getElementById("themeToggle");
                const icon = document.getElementById("themeIcon");

                if (!btn || !icon) return;

                // Load trạng thái cũ
                if (localStorage.getItem("theme") === "dark") {
                    document.body.classList.add("dark");
                    icon.classList.replace("bi-moon", "bi-sun");
                }

                btn.addEventListener("click", () => {
                    document.body.classList.toggle("dark");

                    const isDark = document.body.classList.contains("dark");

                    icon.classList.toggle("bi-moon", !isDark);
                    icon.classList.toggle("bi-sun", isDark);

                    localStorage.setItem("theme", isDark ? "dark" : "light");
                });
            });
        </script>


    </div>
    </div>