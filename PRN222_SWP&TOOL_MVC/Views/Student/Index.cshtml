@model PRN222_SWP_TOOL_MVC.Service.DTO.Request.StudentDashboardRequestDTO

@{
    ViewData["Title"] = "Student";
    Layout = "~/Views/Shared/StudentLayout/_StudentLayout.cshtml";
}

@* Page Tab Bar — fixed strip, rendered outside inner container *@
@await Html.PartialAsync("~/Views/Student/ComponentStudent/_Tabs.cshtml", Model)

<div class="container-fluid">
    <div class="container py-3">

        @* Status Cards *@
        <div class="row g-3 mb-4">
            @await Html.PartialAsync("~/Views/Student/ComponentStudent/_StatusCard.cshtml", Model)
        </div>

        @* Tab Content *@
        <div class="tab-content">
            @if (Model?.CurrentTab == "group")
            {
                @await Html.PartialAsync("~/Views/Student/ComponentStudent/_GroupTab.cshtml", Model)
            }
            else if (Model?.CurrentTab == "topic")
            {
                @await Html.PartialAsync("~/Views/Student/ComponentStudent/_TopicTab.cshtml", Model)
            }
            else if (Model?.CurrentTab == "qa")
            {
                @await Html.PartialAsync("~/Views/Student/ComponentStudent/_QATab.cshtml", Model?.Questions)
            }
        </div>

    </div>
</div>