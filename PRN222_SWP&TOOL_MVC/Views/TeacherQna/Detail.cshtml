@using PRN222_SWP_TOOL_MVC.Service.DTO.QnA
@model QuestionDetailDto

@{
    ViewData["Title"] = "Chi tiết câu hỏi";
    Layout = "~/Views/Shared/TeacherLayout/_TeacherLayout.cshtml";

    string BadgeClass(string s) => s switch {
        "ANSWERED"   => "bg-success",
        "PROCESSING" => "bg-warning text-dark",
        "CLOSED"     => "bg-secondary",
        _            => "bg-danger"
    };
    string BadgeLabel(string s) => s switch {
        "ANSWERED"   => "Đã trả lời",
        "PROCESSING" => "Đang xử lý",
        "CLOSED"     => "Đã đóng",
        _            => "Chờ xử lý"
    };

    var nextStatus = Model.Status switch {
        "PENDING"    => "PROCESSING",
        "PROCESSING" => "ANSWERED",
        "ANSWERED"   => "CLOSED",
        _            => null
    };
    var nextLabel = nextStatus switch {
        "PROCESSING" => "Đánh dấu Đang xử lý",
        "ANSWERED"   => "Đánh dấu Đã trả lời",
        "CLOSED"     => "Đóng câu hỏi",
        _            => null
    };
}

<div class="container mt-4" style="max-width: 860px;">
    <!-- Header -->
    <div class="d-flex align-items-center gap-2 mb-3">
        <a asp-action="Index" class="btn btn-light btn-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h5 class="mb-0 fw-bold">@(string.IsNullOrWhiteSpace(Model.Title) ? "(Không có tiêu đề)" : Model.Title)</h5>
            <small class="text-muted">
                Nhóm: <strong>@Model.GroupName</strong> &nbsp;|&nbsp;
                Topic: <strong>@Model.TopicName</strong> &nbsp;|&nbsp;
                bởi: <strong>@Model.StudentName</strong>
            </small>
        </div>
        <span class="badge @BadgeClass(Model.Status) ms-auto">@BadgeLabel(Model.Status)</span>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger py-2">@TempData["Error"]</div>
    }

    <!-- Thread messages -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold">
            <i class="bi bi-chat-dots me-2"></i>Thread hội thoại
        </div>
        <div class="card-body" style="max-height: 50vh; overflow-y: auto;" id="thread">
            @if (!Model.Messages.Any())
            {
                <p class="text-muted text-center py-4">Chưa có tin nhắn.</p>
            }
            @foreach (var msg in Model.Messages)
            {
                bool isTeacher = msg.SenderRole == "TEACHER";
                <div class="d-flex mb-3 @(isTeacher ? "justify-content-end" : "")">
                    <div style="max-width:75%;">
                        <div class="@(isTeacher ? "bg-primary text-white" : "bg-light") rounded-3 px-3 py-2 shadow-sm">
                            @msg.Content
                        </div>
                        <small class="text-muted d-block @(isTeacher ? "text-end" : "") mt-1">
                            @msg.SenderName &middot; @msg.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")
                        </small>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Trả lời -->
    @if (Model.Status != "CLOSED")
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">
                <i class="bi bi-reply me-2"></i>Trả lời
            </div>
            <div class="card-body">
                <form method="post" asp-action="AddMessage" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <textarea name="Content" class="form-control" rows="4"
                                  placeholder="Nhập câu trả lời cho nhóm học sinh..." required></textarea>
                    </div>
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i> Gửi trả lời (→ Đã trả lời)
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Cập nhật trạng thái -->
    @if (nextStatus != null && nextLabel != null)
    {
        <div class="d-flex justify-content-end">
            <form method="post" asp-action="UpdateStatus" asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Status" value="@nextStatus" />
                <button type="submit" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-right-circle me-1"></i> @nextLabel
                </button>
            </form>
        </div>
    }
</div>

<script>
    // Scroll to bottom of thread
    const el = document.getElementById('thread');
    if (el) el.scrollTop = el.scrollHeight;
</script>
