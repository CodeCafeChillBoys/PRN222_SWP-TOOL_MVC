@model IEnumerable<PRN222_SWP_TOOL_MVC.Repository.Entities.Topic>


<div class="topic-header">
    <div class="topic-header-left">
        <div class="topic-icon">
            <i class="bi bi-journal-text"></i>
        </div>
        <div>
            <h2>Quản lý Đề tài</h2>
            <p>Tạo và quản lý các đề tài cho sinh viên</p>
        </div>
    </div>

    <a asp-action="Create" class="btn-create">
        <span>+</span> Thêm đề tài mới
    </a>
</div>

@if (Model != null && Model.Any())
{
    @foreach (var topic in Model)
    {
        <div class="topic-wrapper">
            <!-- HEADER -->
            <div class="topic-top">
                <div class="topic-title">
                    <div class="topic-icon">📘</div>
                    <div>
                        <h2>@topic.TopicName</h2>
    

                        <span class="semester">
                            @(topic.Semester?.SemesterName ?? "Chua co ky hoc")
                        </span>
                    </div>
                </div>

                <div class="topic-badges">
                    <span class="badge-group">
                        👥 @(topic.TopicRegistrations?.Count ?? 0)/5 nhóm
                    </span>
                    <span class="badge-ai">
                        🤖 AI Ready
                    </span>
                </div>
            </div>

            <!-- DESCRIPTION -->
            <div class="info-box description-box">
                <strong>📌 Mô tả:</strong>
                <p>@topic.Description</p>
            </div>

            <!-- REQUIREMENT -->
            <div class="info-box requirement-box">
                <strong>✅ Yêu cầu:</strong>
                <p>@topic.Requirement</p>
            </div>

            <!-- ACTION -->
            <div class="topic-actions">
                <a asp-action="Edit"
                   asp-route-id="@topic.TopicID"
                   class="btn-edit">
                    ✏ Chỉnh sửa
                </a>

                <a asp-action="Delete"
                   asp-route-id="@topic.TopicID"
                   class="btn-delete">
                    🗑 Xóa
                </a>
            </div>
        </div>
    }
}
else
{
    <div class="empty-box">
        Chưa có đề tài nào.
    </div>
}
