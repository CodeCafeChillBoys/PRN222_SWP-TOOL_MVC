@* @model IEnumerable<PRN222_SWP_TOOL_MVC.Service.DTO.Response.SemesterResponseDTO> *@
@model IEnumerable<SemesterDashboardViewModel>

<form id="createTopicForm">

    <div>
        <label>Tiêu đề đề tài *</label>
        <input type="text" name="topicName" required />
    </div>

    <div>
        <label>Mô tả *</label>
        <textarea name="description" required></textarea>
    </div>

    <div>
        <label>Yêu cầu</label>
        <textarea name="requirement"></textarea>
    </div>

    <div>
        <label>Số nhóm tối đa</label>
        <input type="number" name="maxGroupCount" value="5" />
    </div>

    <div>
        <label>Học kỳ</label>
        <select name="semesterID" required>
            <option value="">-- Chọn học kỳ --</option>

            @foreach (var s in Model)
            {
                <option value="@s.semesterResponseDTO.SemesterID">
                    @s.semesterResponseDTO.SemesterName
                </option>
            }
        </select>
    </div>
    <button type="submit" class="btn-save">Tạo đề tài</button>
</form>