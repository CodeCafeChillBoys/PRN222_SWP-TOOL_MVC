<form>
    <div>
        <label>Tiêu đề đề tài *</label>
        <input type="text" placeholder="VD: Ứng dụng AI trong Y tế">
    </div>

    <div>
        <label>Mô tả *</label>
        <textarea rows="3" placeholder="Mô tả chi tiết về đề tài..."></textarea>
    </div>

    <div>
        <label>Yêu cầu</label>
        <textarea rows="2" placeholder="Kiến thức, kỹ năng cần thiết..."></textarea>
    </div>

    <div class="form-row">
        <div>
            <label>Số nhóm tối đa</label>
            <input type="number" value="5">
        </div>

        <div>
            <label>Học kỳ</label>
            <input type="text" value="HK1 - 2025">
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn-cancel" id="closeModal">Hủy</button>
        <button type="submit" class="btn-save">Tạo đề tài</button>
    </div>

</form>