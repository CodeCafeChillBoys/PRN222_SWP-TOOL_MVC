@model PRN222_SWP_TOOL_MVC.Service.DTO.Request.TeacherDashboardReuqestDTO

@{
    ViewData["Title"] = "Teacher";
    Layout = "~/Views/Shared/TeacherLayout/_TeacherLayout.cshtml";
}

<div class="container-fluid">
    <!-- Filter Header Component -->
    <div class="container">
        @await Html.PartialAsync("~/Views/Teacher/ComponentTeacher/_SemesterFilter.cshtml")
        @await Html.PartialAsync("~/Views/Teacher/ComponentTeacher/_Stats.cshtml")
        @await Html.PartialAsync("~/Views/Teacher/ComponentTeacher/_TopTabs.cshtml")

        <!-- CONTENT -->
        @if (Model.CurrentTab == "qa")
        {
            @await Html.PartialAsync("~/Views/Teacher/ComponentTeacher/_QuestionList.cshtml", Model.Question)
        }
        else if (Model.CurrentTab == "topic")
        {
            @await Html.PartialAsync("~/Views/Teacher/ComponentTeacher/_TopicList.cshtml", Model)
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btn = document.getElementById("themeToggle");
        const icon = document.getElementById("themeIcon");

        if (btn && icon) {
            // Load trạng thái đã lưu
            if (localStorage.getItem("theme") === "light") {
                document.body.classList.add("light-mode");
                icon.classList.replace("bi-moon", "bi-sun");
            }

            btn.addEventListener("click", () => {
                document.body.classList.toggle("light-mode");

                const isLight = document.body.classList.contains("light-mode");

                icon.classList.toggle("bi-moon", !isLight);
                icon.classList.toggle("bi-sun", isLight);

                localStorage.setItem("theme", isLight ? "light" : "dark");
            });
        }
    });
</script>