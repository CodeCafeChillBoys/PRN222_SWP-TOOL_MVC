@model PRN222_SWP_TOOL_MVC.Models.StudentDashboardViewModel
@{
    ViewData["Title"] = "Teacher";
    Layout = "~/Views/Shared/TeacherLayout/_TeacherLayout.cshtml";
}

@* Page Tab Bar — fixed strip, lives outside inner container *@
@await Html.PartialAsync("~/Views/Teacher/ComponentTeacher/_TopTabs.cshtml", Model)

<div class="container-fluid">
    <div class="container">
        @* Semester Filter *@
        @await Html.PartialAsync("~/Views/Teacher/ComponentTeacher/_SemesterFilter.cshtml")

        @* Tab Content *@
        @if (Model.CurrentTab == "qa")
        {
            @await Html.PartialAsync("~/Views/Teacher/ComponentTeacher/_QuestionList.cshtml", Model)
        }
        else if (Model.CurrentTab == "topic")
        {
            @await Html.PartialAsync("~/Views/Teacher/ComponentTeacher/_TopicList.cshtml", Model)
        }
    </div>
</div>